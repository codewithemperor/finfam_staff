
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum CandidateStatus {
  APPLICANT
  ORIENTATION_PENDING
  ORIENTATION_COMPLETED
  ASSESSMENT_PENDING
  ASSESSMENT_PASSED
  ASSESSMENT_FAILED
  OFFER_PENDING
  OFFER_ACCEPTED
  OFFER_DECLINED
  APPOINTMENT_ISSUED
  ACTIVATION_PENDING
  APPROVED_STAFF
}

/// High-level stages of the recruitment journey, in order.
enum RecruitmentStage {
  APPLICATION
  ORIENTATION
  ASSESSMENT
  OFFER
  APPOINTMENT
  ACTIVATION
}

/// Kind of event recorded against a candidate's stage timeline.
enum StageEventType {
  ENTERED
  COMPLETED
  FAILED
  NOTE
}

/// Status of a specific application.
enum ApplicationStatus {
  SUBMITTED
  WITHDRAWN
}

/// Delivery status of a transactional notification.
///
/// SENT means the email provider ACCEPTED the transactional send request —
/// it is deliberately NOT a claim of inbox delivery. Actual delivery, bounces
/// and spam events require provider webhooks, which are out of MVP scope
/// (docs/CONTENT-QUESTIONS.md). FAILED means the last send attempt was
/// rejected or errored; PENDING means not yet (successfully) sent.
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Stable lifecycle notification keys (brief §7). One value per meaningful
/// state change — there is deliberately no per-page-view or per-step key.
/// STAFF_ACCOUNT_CREATED was reserved for Stage 7 and is now fired by Staff
/// Account provisioning (activation transaction + backfill, Stage 7):
/// exactly-once per StaffAccount row via its dedupeKey.
/// STAFF_LOGIN_CODE (Stage 7) carries one-shot OTP semantics — see below.
enum NotificationType {
  APPLICATION_RECEIVED
  ORIENTATION_COMPLETED
  ASSESSMENT_PASSED
  ASSESSMENT_FAILED
  AGREEMENT_ACCEPTED
  APPOINTMENT_ISSUED
  STAFF_ACTIVATED
  ONBOARDING_STARTED
  ONBOARDING_COMPLETED
  STAFF_ACCOUNT_CREATED

  /// Staff Portal email-OTP login code (Stage 7). One-shot semantics: the
  /// plaintext code exists only in memory between creation and the single
  /// delivery attempt, so the payload can never be re-derived for a retry —
  /// a failed delivery is terminal for that code and the user requests a
  /// fresh one. Codes themselves are stored hashed on staff_login_codes.
  STAFF_LOGIN_CODE

  /// Daily-report receipt (Stage 8). Queued inside the ONE submission
  /// transaction that wins the DRAFT → SUBMITTED latch, keyed
  /// "DAILY_REPORT_SUBMITTED:<reportId>" — exactly once per submitted
  /// report. A concise transactional receipt (report date + received
  /// confirmation), NOT a metrics digest and never a reminder — no
  /// DAILY_REPORT_REMINDER exists until a deadline policy is confirmed.
  DAILY_REPORT_SUBMITTED

  /// Admin console email-OTP sign-in code (Stage 11). One-shot semantics,
  /// identical in kind to STAFF_LOGIN_CODE: the plaintext code exists only
  /// in memory between creation and the single delivery attempt, so the
  /// payload can never be re-derived for a retry — a failed delivery is
  /// terminal for that code. Codes are stored hashed on admin_login_codes.
  /// The recipient is the AdminAccount email (no Candidate row exists for
  /// administrators — notification_deliveries.candidateId stays null, the
  /// recipient identity accurately represents the real recipient).
  ADMIN_LOGIN_CODE
}

/// Status of a Staff Portal account (Stage 7). SUSPENDED exists so future
/// administrative workflows can disable access without deleting the Staff
/// identity; every auth/session check must respect it. No suspension UI
/// exists in the MVP (docs/CONTENT-QUESTIONS.md).
enum StaffAccountStatus {
  ACTIVE
  SUSPENDED
}

/// Lifecycle of one daily activity report (Stage 8). Deliberately the
/// SMALLEST useful lifecycle: DRAFT (being written, freely editable) →
/// SUBMITTED (final, read-only permanently in the Staff MVP). There is
/// deliberately no REVIEWED/APPROVED/REJECTED/FLAGGED — no supervisor
/// workflow exists, and inventing one would be speculative.
enum DailyReportStatus {
  DRAFT
  SUBMITTED
}

/// One Staff member's reported activity for ONE reporting date (Stage 8 —
/// Daily Reporting & Accountability, an ongoing STAFF PLATFORM module that
/// adds NO recruitment state: no CandidateStatus, no RecruitmentStage, no
/// StageEvent). Flat typed columns carry the nine approved daily metrics
/// (the four categories taught by the onboarding "accountability" step) —
/// not a JSON blob and not metric rows — because the set is small, fixed
/// and individually validated/displayed. `@@unique([staffId, reportDate])`
/// is the one-report-per-staff-per-date rule and the concurrency backstop:
/// create-or-get races lose the P2002 and re-read the winner.
///
/// Facts kept separate on purpose (brief §4): `reportDate` is the calendar
/// date the reported work occurred (Africa/Lagos — stored as that calendar
/// DATE, see src/lib/dates/lagos.ts), while `submittedAt` is the server
/// instant the report was finalised; createdAt/updatedAt are row
/// bookkeeping and never stand in for the activity date.
///
/// The data is STAFF SELF-REPORTED (brief §22): it is accountability/
/// activity data only — never presented as independently verified, never
/// used for compensation (no ₦650 payroll path exists anywhere), and it
/// contains NO person-level member/prospect records (that is a future
/// module). `version` pins the report-schema interpretation at creation.
model DailyReport {
  id      String            @id @default(cuid())
  /// Owning Staff row — resolved from the authenticated session chain,
  /// NEVER from client input (brief §31/§32).
  staffId String
  staff   Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// Calendar date the reported work occurred (Africa/Lagos). Stored as
  /// that DATE (UTC midnight of the Lagos date, src/lib/dates/lagos.ts).
  reportDate DateTime        @db.Date
  /// Report-schema version pinned at creation ("1.0",
  /// src/config/daily-report.ts). Immutable.
  version String
  status  DailyReportStatus @default(DRAFT)

  // ── Prospects ─────────────────────────────────────────────────────────
  individualsContacted Int @default(0)
  groupsApproached     Int @default(0)
  followUpActivities   Int @default(0)
  // ── Member Growth ─────────────────────────────────────────────────────
  newRegistrations          Int @default(0)
  establishedMembersCreated Int @default(0)
  // ── Savings Activities ────────────────────────────────────────────────
  firstDepositsAchieved Int @default(0)
  savingsGoalsActivated Int @default(0)
  // ── Community Activities ──────────────────────────────────────────────
  memberEngagement Int @default(0)
  connectionsBuilt Int @default(0)

  /// Optional plain-text context the counts cannot capture. Trimmed,
  /// max 1000 chars, server-validated. Plain text only — never PII.
  activitySummary String?

  /// Server finalisation instant. Null while DRAFT; the one-way latch
  /// (status DRAFT → SUBMITTED via a conditional update) stamps it exactly
  /// once, so repeated/concurrent submits yield ONE timestamp.
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// One Staff member + one activity date = one report.
  @@unique([staffId, reportDate])
  /// Stage 11 admin console: month/day filtering across ALL staff on
  /// /admin/reports cannot use the staff-prefixed unique above.
  @@index([reportDate])
  /// Production-readiness remediation (§17): /admin/reports filters
  /// `status = SUBMITTED` (equality) and ranges/orders on reportDate
  /// (src/server/services/admin-reports.ts). Composite serves both.
  @@index([status, reportDate])
  @@map("daily_reports")
}

/// A person going through the FinFam recruitment journey.
model Candidate {
  id              String          @id @default(cuid())
  /// Public, non-guessable lookup key used by candidates to check their
  /// status. Not a secret on its own; never put PII in URLs instead.
  referenceNumber String          @unique
  fullName        String
  email           String          @unique
  phone           String
  city            String?
  status          CandidateStatus @default(APPLICANT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  applications Application[]
  events       StageEvent[]
  orientation  Orientation?
  attempts     AssessmentAttempt[]
  agreement    Agreement?
  appointment  Appointment?
  staff        Staff?
  notifications NotificationDelivery[]

  @@index([status])
  @@map("candidates")
}

/// A submitted application for a specific role.
model Application {
  id          String            @id @default(cuid())
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roleTitle   String
  status      ApplicationStatus @default(SUBMITTED)
  submittedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([candidateId])
  @@map("applications")
}

/// Append-only timeline of stage transitions. Powers the candidate status
/// page and (later) the admin audit trail. Never mutated, only appended.
model StageEvent {
  id          String           @id @default(cuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage       RecruitmentStage
  type        StageEventType
  description String?
  occurredAt  DateTime         @default(now())

  @@index([candidateId, occurredAt])
  @@map("stage_events")
}

/// A candidate's progress through the FinFam Staff Orientation Workshop
/// (FSOW) — stage 1 after the application. Created lazily when the candidate
/// completes their first section; one row per candidate.
model Orientation {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Resume point: the section the candidate is currently on (stable id from
  /// src/config/orientation.ts, e.g. "your-role"). Derived on write, stored
  /// so "continue where you stopped" survives content reordering.
  currentSectionId String?
  /// When the candidate acknowledged the integrity policy in the completion
  /// confirmation (server-verified — never trusted from the client).
  acknowledgedAt DateTime?
  /// When the candidate explicitly completed the workshop. Null until the
  /// completion action is accepted by the server.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections OrientationSection[]

  @@map("orientations")
}

/// Completion record for one orientation section. Append-only: one row per
/// completed section per candidate (enforced by the unique constraint); rows
/// are never edited or deleted.
model OrientationSection {
  id            String      @id @default(cuid())
  orientationId String
  orientation   Orientation @relation(fields: [orientationId], references: [id], onDelete: Cascade)
  /// Stable section id from src/config/orientation.ts (e.g. "about-finfam").
  sectionId     String
  completedAt   DateTime    @default(now())

  @@unique([orientationId, sectionId])
  @@index([orientationId])
  @@map("orientation_sections")
}

/// One run of the Automated Interview Assessment (stage 2). Created when the
/// candidate explicitly starts (or retakes) the assessment. A candidate may
/// have several attempts over time; the active attempt is the one without a
/// submittedAt. The final result is persisted on this row at submission —
/// computed exclusively server-side (src/server/assessment-content.ts).
model AssessmentAttempt {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// 1-based counter per candidate (resumes never create new attempts).
  attemptNumber Int
  startedAt     DateTime  @default(now())
  /// Null while the attempt is active; set once the server accepts a
  /// submission. Submission is idempotent-safe — double submits never
  /// create duplicate results.
  submittedAt   DateTime?
  // --- Final result (set only by the server-side scoring service) ---------
  correctCount  Int?
  marksAwarded  Int?
  totalMarks    Int?
  percentage    Float?
  passed        Boolean?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  questions AssessmentAttemptQuestion[]
  answers   AssessmentAnswer[]

  @@unique([candidateId, attemptNumber])
  @@index([candidateId])
  @@map("assessment_attempts")
}

/// Persisted question order for one attempt (snapshot of the authoritative
/// config order at start time). Keeps resume/navigation stable for the life
/// of the attempt even if the config later changes.
model AssessmentAttemptQuestion {
  id         String            @id @default(cuid())
  attemptId  String
  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// Stable question id from src/config/assessment.ts (e.g. "q-01").
  questionId String
  /// 0-based position in this attempt's fixed order.
  position   Int

  @@unique([attemptId, questionId])
  @@index([attemptId, position])
  @@map("assessment_attempt_questions")
}

/// The candidate's saved answer to one question of one attempt. Upserted on
/// every change (idempotent autosave); answers are rejected after the
/// attempt has been submitted.
model AssessmentAnswer {
  id             String            @id @default(cuid())
  attemptId      String
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  /// 0-based index of the chosen option, validated server-side.
  selectedOption Int
  updatedAt      DateTime          @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("assessment_answers")
}

/// The candidate's recorded decision on the Responsibility & Reward
/// Agreement — the OFFER stage of the journey (candidate-facing label:
/// "Agreement"). One row per candidate, created only when an explicit,
/// server-validated acceptance is received; opening or viewing the
/// agreement NEVER creates a row or implies acceptance. The `version`
/// pins the exact agreement content the candidate accepted
/// (src/config/agreement.ts) so later content changes stay auditable.
///
/// Decline is NOT modelled yet — the decline policy is an unresolved
/// business decision (docs/CONTENT-QUESTIONS.md §16); the OFFER_DECLINED
/// status exists in the enum for that future decision.
model Agreement {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Content version identifier the acceptance applies to (e.g. "1.0").
  version     String
  /// When the candidate explicitly accepted. Null until acceptance is
  /// accepted by the server (never set by viewing).
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("agreements")
}

/// The candidate's issued Provisional Letter of Appointment — stage 4 of
/// the journey. Issued lazily and exactly once, server-side, when an
/// OFFER_ACCEPTED candidate first opens the appointment stage
/// (src/server/services/appointment.ts); viewing again is a read-only
/// record and NEVER re-issues or mutates the letter.
///
/// Hybrid historical-integrity model: the columns below are the immutable,
/// candidate-specific SNAPSHOT (who, which letter, when, under which
/// content version) while the letter TEXT itself lives in an append-only
/// content registry (src/config/appointment.ts, APPOINTMENT_CONTENT_
/// VERSIONS) resolved by `version`. An appointment issued under v1.0 must
/// stay reproducible as v1.0 forever — later wording changes append new
/// registry versions and never touch issued ones. There is deliberately no
/// separate effectiveDate column: the letter date IS `issuedAt` for the
/// MVP (docs/CONTENT-QUESTIONS.md §23 keeps the distinction open).
model Appointment {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Official letter reference in the FFL/HR/PLA/NNN format. Allocated
  /// server-side from the AppointmentSequence inside the issuance
  /// transaction — never derived from client input, never from count(*).
  /// The unique constraint is the final backstop against duplicates.
  appointmentReference String @unique
  /// Pinned content-registry version (e.g. "1.0") the letter was issued
  /// under. Immutable after issuance.
  version     String
  /// Printed candidate name, snapshotted from Candidate.fullName at
  /// issuance. Never read from the client at render time.
  printedName String
  /// Official appointment designation, snapshotted at issuance. The
  /// approved MVP value is "Remote Staff" (the designation used by the
  /// official Provisional Letter of Appointment) — not renamed to any
  /// other role title (docs/CONTENT-QUESTIONS.md §21).
  roleTitle   String
  /// Server issuance timestamp. Doubles as the printed letter date for
  /// the MVP; no separate effectiveDate exists (§23).
  issuedAt    DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("appointments")
}

/// Server-controlled sequence behind the FFL/HR/PLA/NNN appointment
/// references. A single row per sequence: `value` holds the LAST allocated
/// number; allocation is an atomic `UPDATE ... SET value = value + 1
/// RETURNING value` inside the issuance transaction, so concurrent
/// issuances can never receive the same number (the unique constraint on
/// appointments.appointmentReference stays the final backstop).
///
/// Initialisation: the supplied official sample letter carries
/// FFL/HR/PLA/012 and is treated as the most recently existing appointment
/// (an externally issued document — it is NOT written into the database).
/// The sequence therefore starts at 12, making the first system-issued
/// reference FFL/HR/PLA/013. Documented assumption; see
/// docs/CONTENT-QUESTIONS.md §22.
model AppointmentSequence {
  id    String @id @default(cuid())
  /// Singleton sequence name (one row: "PROVISIONAL_APPOINTMENT").
  name  String @unique
  /// Last allocated sequence number (initialised to 12 by migration).
  value Int

  @@map("appointment_sequences")
}

/// The candidate's permanent FinFam staff identity — stage 5 of the journey.
/// Created exactly once, server-side, when an eligible (APPOINTMENT_ISSUED
/// or ACTIVATION_PENDING) candidate explicitly activates their staff profile
/// (src/server/services/activation.ts); this row IS the activation record —
/// there is deliberately no separate StaffActivation model. Opening the
/// activation stage NEVER creates this row; only the explicit, server-
/// validated activation action does.
///
/// Only identity facts that must remain stable are snapshotted here
/// (staffId, version, roleTitle, appointmentReference, activatedAt) — all
/// immutable after activation. Personal data is deliberately NOT duplicated:
/// name, contact details and application data stay on the Candidate/
/// Application records and are reached by relation.
model Staff {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Official staff identifier (Stage 5 MVP format FF-STF-NNNN, approved in
  /// docs/CONTENT-QUESTIONS.md §30). Allocated server-side from the
  /// StaffIdSequence inside the activation transaction — never derived from
  /// client input, never from count(*). The unique constraint is the final
  /// backstop. Immutable once assigned; future format changes never modify
  /// already-assigned IDs.
  staffId     String    @unique
  /// Activation-content version pinned at activation (e.g. "1.0",
  /// src/config/activation.ts). Immutable.
  version     String
  /// Official designation, snapshotted FROM the issued Appointment row at
  /// activation ("Remote Staff" for the current appointment version). The
  /// appointment remains the authoritative source for the designation under
  /// which the person was activated. Immutable.
  roleTitle   String
  /// Appointment reference, snapshotted at activation so the staff identity
  /// is self-contained. Immutable.
  appointmentReference String
  /// Server activation timestamp. Immutable.
  activatedAt DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Staff-side operational onboarding (stage 6) — created lazily on the
  /// first valid onboarding visit; one journey per Staff record.
  onboarding StaffOnboarding?

  /// Staff Portal account (Stage 7) — provisioned INSIDE the activation
  /// transaction by the same code path the backfill uses
  /// (src/server/services/staff-accounts.ts), so an activation can never
  /// exist without its portal account.
  account StaffAccount?

  /// Daily activity reports (Stage 8) — one per reporting date at most
  /// (unique [staffId, reportDate]); owned exclusively via the session.
  reports DailyReport[]

  /// Staff Training enrollments (Stage 9) — one per course version at most
  /// (unique [staffId, courseId, courseVersion]); owned exclusively via
  /// the session.
  trainingEnrollments StaffTrainingEnrollment[]

  /// Production-readiness remediation (§17): the admin staff directory
  /// lists ALL staff ordered by activation, newest first
  /// (orderBy activatedAt desc, src/server/services/admin-directory.ts).
  @@index([activatedAt])
  @@map("staff")
}

/// The Staff member's authenticated Staff Portal access (Stage 7). One row
/// per Staff record, created in the SAME transaction as the Staff row by
/// staff activation (and idempotently by the backfill script for pre-existing
/// Staff). The account owns login codes and portal sessions and carries the
/// future suspension flag — nothing else:
///
/// - It duplicates NO identity data. Name, email, phone and appointment
///   facts are reached through StaffAccount → Staff → Candidate; the login
///   email IS the candidate's registered email (brief §3/§4).
/// - It stores NO credentials. Login is email OTP (hashed codes live on
///   StaffLoginCode); sessions are DB rows with only the token hash
///   (StaffSession).
/// - status = SUSPENDED blocks code requests, verification and session
///   resolution; there is deliberately no admin UI in this stage.
model StaffAccount {
  id      String             @id @default(cuid())
  /// One portal account per Staff identity.
  staffId String             @unique
  staff   Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// ACTIVE by default; SUSPENDED refuses every auth path (brief §17).
  status  StaffAccountStatus @default(ACTIVE)
  /// Set on each successful OTP verification.
  lastLoginAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  loginCodes StaffLoginCode[]
  sessions   StaffSession[]

  @@map("staff_accounts")
}

/// One emailed email-OTP login code for a Staff Portal account (Stage 7).
///
/// Security properties (brief §6/§7/§10): the 6-digit code is generated with
/// cryptographically secure randomness and stored ONLY as a sha256 hash —
/// the plaintext lives in memory just long enough to render the one-shot
/// notification payload and is never persisted or logged. A code is
/// single-use (consumedAt latch), expires after 10 minutes, tolerates at
/// most 5 failed verification attempts, and only the LATEST code of an
/// account is ever verifiable (a newer request replaces older ones).
/// Request-side cooldown and rate limits are enforced by the auth service
/// from createdAt history (60s cooldown, 5 codes / 15 minutes).
model StaffLoginCode {
  id        String       @id @default(cuid())
  accountId String
  account   StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// sha256 hex digest of the 6-digit code. Never the plaintext.
  codeHash  String
  /// After this instant the code is dead even if unused.
  expiresAt DateTime
  /// Single-use latch: set by the ONE verification transaction that wins.
  consumedAt DateTime?
  /// Failed verification attempts against this code (max 5).
  attemptCount Int      @default(0)
  createdAt DateTime     @default(now())

  @@index([accountId, createdAt])
  @@map("staff_login_codes")
}

/// One authenticated Staff Portal session (Stage 7). The browser holds only
/// an opaque random token in an HttpOnly cookie; the server stores ONLY the
/// sha256 hash of that token, so a database read can never mint a session.
/// Sessions expire (7-day MVP default), can be revoked (logout — the DB row
/// is revoked, not merely the cookie dropped) and resolve only for ACTIVE
/// accounts, so a suspended Staff member loses portal access immediately.
model StaffSession {
  id        String       @id @default(cuid())
  accountId String
  account   StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// sha256 hex digest of the cookie token. Unique — lookup key.
  tokenHash String       @unique
  createdAt DateTime     @default(now())
  /// Hard expiry checked on every resolution (MVP: 7 days, configurable).
  expiresAt DateTime
  /// Logout / future suspension revokes the row — cookie deletion alone is
  /// never trusted.
  revokedAt DateTime?
  /// Refreshed opportunistically by /api/staff/me.
  lastSeenAt DateTime?

  @@index([accountId])
  @@map("staff_sessions")
}

/// Server-controlled sequence behind the FF-STF-NNNN Staff IDs. A single
/// row per sequence: `value` holds the LAST allocated number; allocation is
/// an atomic `UPDATE ... SET value = value + 1 RETURNING value` inside the
/// activation transaction, so concurrent activations can never receive the
/// same ID (the unique constraint on staff.staffId stays the final
/// backstop).
///
/// Initialisation: seeded to 0 by migration (approved Stage 5 MVP
/// convention), so the first system-issued Staff ID is FF-STF-0001.
model StaffIdSequence {
  id    String @id @default(cuid())
  /// Singleton sequence name (one row: "STAFF_ID").
  name  String @unique
  /// Last allocated sequence number (initialised to 0 by migration).
  value Int

  @@map("staff_id_sequences")
}

/// Staff-side operational onboarding (stage 6) — the FINAL stage of the
/// FinFam recruitment/onboarding MVP. One record per Staff member, created
/// lazily when an eligible (APPROVED_STAFF with a Staff row) staff member
/// first opens the onboarding stage (src/server/services/onboarding.ts).
///
/// Onboarding is deliberately NOT part of the recruitment state machine:
/// it adds no CandidateStatus value, no RecruitmentStage value and no
/// StageEvent — the six-stage recruitment stepper and the append-only
/// StageEvent timeline stay recruitment-only. Auditability comes from this
/// record itself: startedAt, the per-step StaffOnboardingStep completion
/// rows, the final completedAt and the pinned content version.
///
/// Opening onboarding NEVER completes a step and never completes onboarding;
/// step completion and the final acknowledgement are explicit, server-
/// validated actions. `currentStepId` is the resume point (the first
/// not-yet-completed step id from src/config/onboarding.ts), derived on
/// write so "continue where you stopped" survives content reordering.
model StaffOnboarding {
  id          String @id @default(cuid())
  /// One onboarding journey per Staff record.
  staffId     String @unique
  staff       Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// Onboarding-content version pinned at entry ("1.0",
  /// src/config/onboarding.ts); re-pinned at completion so the row records
  /// which set of instructions the staff member completed.
  version     String
  /// Resume point: first not-yet-completed step (stable config id, e.g.
  /// "welcome"). Derived on write — never trusted from the client.
  currentStepId String?
  /// When the staff member first opened onboarding (lazy entry).
  startedAt   DateTime
  /// When the staff member explicitly completed onboarding. Null until the
  /// completion action is accepted by the server; the exactly-once latch
  /// for completion is `completedAt = null` → set.
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps StaffOnboardingStep[]

  @@map("staff_onboarding")
}

/// Transactional email delivery record (outbox pattern, brief §9).
///
/// One row per lifecycle notification INTENT. Rows are created by the
/// central notification service in the SAME database transaction as the
/// meaningful state change they belong to (brief §13), so a committed
/// business event always has a corresponding notification intent even if
/// the email provider is down. The unique `dedupeKey` is the exactly-once
/// latch: user double-clicks, request retries, concurrent requests and
/// route refreshes can never queue a duplicate email (brief §11).
///
/// The actual Mailjet network call happens AFTER the business transaction
/// commits — never while the transaction holds database locks (§16). A
/// Mailjet outage therefore marks rows FAILED/PENDING but can never roll
/// back or corrupt recruitment state (§12/§14).
///
/// No credentials are ever stored here; no rendered HTML is stored — the
/// email body is re-derived from immutable snapshot data at send time so
/// retries stay faithful (staff/appointment/agreement/attempt snapshot
/// rows are immutable by schema design).
model NotificationDelivery {
  id        String             @id @default(cuid())
  /// The candidate the notification belongs to, where applicable. Cascade
  /// delete mirrors every other candidate-owned record.
  candidateId String?
  candidate Candidate?         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Stable lifecycle key (NotificationType).
  type      NotificationType
  /// Stable idempotency key "<TYPE>:<immutable entity id>" (e.g.
  /// "APPLICATION_RECEIVED:<candidateId>", "ASSESSMENT_PASSED:<attemptId>",
  /// "STAFF_ACTIVATED:<staff row id>"). Unique — the exactly-once latch.
  dedupeKey String             @unique
  /// Recipient email snapshotted at enqueue time (never re-read at send).
  recipientEmail String
  /// Code-owned template registry version used to render the email
  /// (src/server/notifications/notification-templates.ts).
  templateVersion String
  /// Email provider handling delivery (MVP: "mailjet").
  provider  String
  /// Provider message id, when the provider accepted a send.
  providerMessageId String?
  /// PENDING until the provider accepts a send; SENT once accepted
  /// (NOT a claim of inbox delivery — see NotificationStatus).
  status    NotificationStatus @default(PENDING)
  /// Number of delivery attempts made (bounded by config).
  attemptCount Int             @default(0)
  /// When the provider accepted the send (status became SENT).
  sentAt    DateTime?
  /// Last delivery attempt, successful or not.
  lastAttemptAt DateTime?
  /// Safe error code from the last failed attempt (HTTP status class or
  /// NETWORK_ERROR/TIMEOUT). Never contains credentials or bodies.
  lastErrorCode String?
  /// Safe error message from the last failed attempt.
  lastErrorMessage String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
  @@index([candidateId])
  /// Production-readiness remediation (§17): the retry worker polls
  /// status IN (PENDING, FAILED) ordered oldest-first
  /// (retryPendingNotifications, src/server/notifications/
  /// notification-service.ts). Composite serves the inequality+order.
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

/// Completion record for one onboarding step. Append-only: one row per
/// completed step per onboarding journey (enforced by the unique
/// constraint); rows are never edited or deleted. Steps are sequential —
/// order is enforced server-side against src/config/onboarding.ts, never
/// trusted from the client.
model StaffOnboardingStep {
  id           String          @id @default(cuid())
  onboardingId String
  onboarding   StaffOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  /// Stable step id from src/config/onboarding.ts (e.g. "welcome").
  stepId       String
  completedAt  DateTime        @default(now())

  @@unique([onboardingId, stepId])
  @@index([onboardingId])
  @@map("staff_onboarding_steps")
}

/// Staff Training enrollment (Stage 9) — one Staff member's progress
/// through ONE version of ONE course. An ongoing STAFF PLATFORM module
/// that adds NO recruitment state: no CandidateStatus, no RecruitmentStage,
/// no StageEvent, and no Staff identity change of any kind (completion
/// never touches Staff, StaffAccount, Candidate, appointment, onboarding
/// or Daily Reports — src/server/services/staff-training.ts).
///
/// Course CONTENT is source-controlled (src/config/training/, brief §2/§3):
/// this row stores PROGRESS ONLY — there is no course CMS and no
/// database-authored content. `courseVersion` is PINNED at first open, so
/// a future course version can only coexist as a separate enrollment and
/// never silently rewrites a 1.0 completion (brief §23/§50).
///
/// Enrollment is LAZY (brief §24): the overview page/API never creates a
/// row — opening /staff/training/[courseId] create-or-gets it. The unique
/// [staffId, courseId, courseVersion] constraint is the concurrency
/// backstop: the P2002 loser re-reads the winner, so concurrent first
/// opens produce exactly ONE enrollment.
///
/// Training state is derived, not stored as an enum: NOT_STARTED /
/// IN_PROGRESS derive from the lesson-progress rows, COMPLETED from
/// `completedAt`. The exactly-once completion latch is
/// `completedAt = null` → set (conditional updateMany inside the final
/// lesson's transaction, brief §28).
model StaffTrainingEnrollment {
  id            String    @id @default(cuid())
  /// Owning Staff row — resolved from the authenticated session chain,
  /// NEVER from client input (brief §18).
  staffId       String
  staff         Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// Stable course id from src/config/training (e.g. "staff-foundations").
  courseId      String
  /// Course content version PINNED at first open (e.g. "1.0"). Immutable.
  courseVersion String
  /// When the Staff member first opened the course (lazy entry).
  startedAt     DateTime
  /// Course completion instant. Null until all lessons are complete; the
  /// conditional latch stamps it exactly once. Never cleared.
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Append-only lesson completion facts, in lesson order.
  lessons StaffTrainingLessonProgress[]

  /// One enrollment per Staff member per course version — the race-safe
  /// create-or-get backstop.
  @@unique([staffId, courseId, courseVersion])
  @@index([staffId, courseId])
  @@map("staff_training_enrollments")
}

/// Completion fact for ONE lesson of ONE training enrollment (Stage 9).
/// Append-only: one row per completed lesson per enrollment (enforced by
/// the unique constraint); rows are never edited or deleted, and there is
/// deliberately NO "uncomplete lesson" action (brief §21). Lesson order is
/// enforced server-side against the pinned course content — sequential
/// first completion, never trusted from the browser.
model StaffTrainingLessonProgress {
  id           String                  @id @default(cuid())
  enrollmentId String
  enrollment   StaffTrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Stable lesson id from the pinned course content
  /// (src/config/training/staff-foundations.ts).
  lessonId     String
  completedAt  DateTime                @default(now())

  /// One completion fact per lesson per enrollment.
  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@map("staff_training_lesson_progress")
}

// ═══════════════════════════════════════════════════════════════════════
// Stage 11 — Admin / Supervisor Operations (MVP: single ADMIN privilege
// level, no Supervisor role, no RBAC — approved brief §3/§4).
//
// The Admin domain is STRUCTURALLY SEPARATE from the Staff domain:
//
//   Staff:  StaffSession → StaffAccount → Staff → Candidate
//   Admin:  AdminSession → AdminAccount
//
// An AdminAccount is deliberately NOT connected to Candidate or Staff even
// when the same person holds both identities — those are separate domains
// with separate cookies (ff_staff_session vs ff_admin_session) and neither
// session can ever satisfy the other domain's guard (approved brief §3).
// ═══════════════════════════════════════════════════════════════════════

/// Status of a FinFam Admin console account (Stage 11). Mirrors the access
/// semantics of StaffAccountStatus: SUSPENDED refuses code requests,
/// verification and session resolution. Deliberately NO TERMINATED/RESIGNED
/// states exist for admins either — access enable/disable is the whole model.
enum AdminAccountStatus {
  ACTIVE
  SUSPENDED
}

/// Privileged actions recorded in the append-only admin audit log (Stage
/// 11). MVP writes are exactly the two StaffAccount access transitions;
/// future privileged actions (e.g. resource publishing) extend this enum —
/// they never bypass the audit log.
enum AdminAuditAction {
  STAFF_SUSPENDED
  STAFF_REACTIVATED
}

/// One FinFam management identity authorized for the /admin console
/// (Stage 11). Provisioned ONLY by scripts/bootstrap-admin.ts — there is no
/// public registration, no password, no invite flow (approved brief §38).
/// Stores no credentials: sign-in is email OTP (hashed codes live on
/// AdminLoginCode); sessions are DB rows holding only the token hash.
model AdminAccount {
  id      String             @id @default(cuid())
  /// Lowercase-normalized, unique. The OTP delivery address and the audit
  /// "actor" identity. Never used for authorization of any Staff surface.
  email   String             @unique
  /// ACTIVE by default; SUSPENDED refuses every admin auth path. A
  /// suspended admin is NOT reactivated by the bootstrap script — recovery
  /// is an explicit future break-glass policy (approved brief §37/§39).
  status  AdminAccountStatus @default(ACTIVE)
  /// Set on each successful OTP verification.
  lastLoginAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  loginCodes  AdminLoginCode[]
  sessions    AdminSession[]
  auditEvents AdminAuditEvent[]

  @@map("admin_accounts")
}

/// One emailed email-OTP login code for an Admin console account (Stage
/// 11). Same security properties as StaffLoginCode: 6-digit CSPRNG code
/// stored ONLY as a sha256 hash, single-use (consumedAt latch), 10-minute
/// expiry, max 5 failed attempts, latest-code-only verification.
model AdminLoginCode {
  id        String       @id @default(cuid())
  accountId String
  account   AdminAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// sha256 hex digest of the 6-digit code. Never the plaintext.
  codeHash  String
  /// After this instant the code is dead even if unused.
  expiresAt DateTime
  /// Single-use latch: set by the ONE verification transaction that wins.
  consumedAt DateTime?
  /// Failed verification attempts against this code (max 5).
  attemptCount Int      @default(0)
  createdAt DateTime     @default(now())

  @@index([accountId, createdAt])
  @@map("admin_login_codes")
}

/// One authenticated Admin console session (Stage 11). DB row + opaque
/// cookie token (ff_admin_session), exactly like the Staff pattern but a
/// structurally separate domain. Shorter absolute TTL (12h default,
/// ADMIN_SESSION_TTL_HOURS) because the surface carries privileged writes.
model AdminSession {
  id        String       @id @default(cuid())
  accountId String
  account   AdminAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// sha256 hex digest of the cookie token. Unique — lookup key.
  tokenHash String       @unique
  createdAt DateTime     @default(now())
  /// Hard expiry checked on every resolution — no sliding renewal.
  expiresAt DateTime
  /// Logout revokes the row — cookie deletion alone is never trusted.
  revokedAt DateTime?
  /// Refreshed opportunistically by authenticated admin reads.
  lastSeenAt DateTime?

  @@index([accountId])
  @@map("admin_sessions")
}

/// Append-only privileged-action audit record (Stage 11). Every management
/// write answers WHO (actor), WHAT (action + target), WHEN (createdAt) and
/// WHY (reason). There is deliberately NO update/delete path in code, no
/// admin UI mutation and no retention/expiry job — the log is read-only
/// after creation and retained indefinitely (retention period is an open
/// business/legal question, docs/CONTENT-QUESTIONS.md).
model AdminAuditEvent {
  id      String           @id @default(cuid())
  /// The AdminAccount performing the action. ALWAYS resolved from the
  /// AdminSession — never accepted from the client (approved brief §36).
  /// Restrict (not Cascade): audit history outlives everything.
  actorId String
  actor   AdminAccount     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action  AdminAuditAction
  /// Coarse target domain, e.g. "STAFF_ACCOUNT".
  targetType String
  /// Database row id of the target. Human-readable identity (FF-STF-NNNN)
  /// lives in metadata, resolvable from targetId.
  targetId   String
  /// Free-text justification (suspension: required, 1–500 chars,
  /// trimmed; reactivation: optional note).
  reason  String?
  /// Conservative structured context — approved fields only: staffId,
  /// previousStatus, newStatus. NEVER a dump of whole records or PII.
  metadata Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("admin_audit_events")
}

/// Sliding-window rate-limit event for UNAUTHENTICATED public mutation /
/// recovery endpoints (production-readiness remediation §14/§15):
/// POST /api/applications, POST /api/recruitment/recover-reference and the
/// legacy reference-gated onboarding writes. Pattern mirrors the OTP
/// request-window limiter (DB count over a rolling window → 429) so abuse
/// damping behaves identically across instances behind one database.
///
/// Privacy: the client identity is stored ONLY as
/// sha256("<bucket>:<client ip>") — the table can never be read back as an
/// IP log. Rows are pruned opportunistically (older than the window) on
/// every enforcement call; there is deliberately no other retention.
model RateLimitEvent {
  id     String   @id @default(cuid())
  /// Logical endpoint group, e.g. "applications", "recruitment-recovery".
  bucket String
  /// sha256 hex of "<bucket>:<client ip>". Never a raw IP or email.
  clientKey String
  createdAt DateTime @default(now())

  @@index([bucket, clientKey, createdAt])
  @@map("rate_limit_events")
}
