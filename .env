# FinFam runtime environment (TRACKED by explicit owner decision, 2026-09).
# SAFE TO COMMIT ONLY BECAUSE: no secrets (Mailjet keys empty) and dev OTP
# echo is enabled for sandbox/dev. Before any production deployment:
#   1. set NOTIFICATIONS_ENABLED=false->true with real Mailjet creds via the
#      platform secret manager (NOT in this file), and
#   2. set STAFF_AUTH_DEV_CODE_ECHO=false and ADMIN_AUTH_DEV_CODE_ECHO=false,
#   3. re-ignore this file in .gitignore.
# .env.example remains the documented template.

# ── Database ────────────────────────────────────────────────────────────
# Bundled PostgreSQL started by `bun run db:start` (127.0.0.1 only).
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/finfam

# ── Transactional notifications (Mailjet) ──────────────────────────────
# false in dev: lifecycle events queue rows, no network send ever happens.
NOTIFICATIONS_ENABLED=false
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME="FinFam Recruitment"
APP_BASE_URL=http://127.0.0.1:3000

# ── Dev/test OTP echo (PRODUCTION MUST BE FALSE) ───────────────────────
# The automated suite completes OTP logins via response echo while
# NOTIFICATIONS_ENABLED=false. Never enable outside development.
STAFF_AUTH_DEV_CODE_ECHO=true
ADMIN_AUTH_DEV_CODE_ECHO=true

# ── Staff Portal ────────────────────────────────────────────────────────
ONBOARDING_WHATSAPP_NUMBER=
STAFF_SESSION_TTL_DAYS=7
DAILY_REPORT_BACKDATE_LIMIT_DAYS=7

# ── Admin Console (Stage 11) ────────────────────────────────────────────
ADMIN_SESSION_TTL_HOURS=12
