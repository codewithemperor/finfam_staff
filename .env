# ---------------------------------------------------------------------------
# FinFam Recruitment Portal — environment variables
# Never commit real secrets. See .env.example for the canonical list.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by Prisma (local dev server: `bun run db:start`)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/finfam?schema=public

# Local embedded PostgreSQL tuning (optional)
# FINFAM_DB_PORT=5432
# FINFAM_DB_USER=postgres
# FINFAM_DB_NAME=finfam
