# FinFam Recruitment Portal — environment template.
#
# Copy this file to `.env` (`cp .env.example .env`) and adjust the values.
# `.env` is git-ignored and never committed; this template is.
#
# Next.js, Prisma, and Bun load this file when copied to `.env`.

# ── Database (required) ────────────────────────────────────────────────
# Prisma connection string. Local development expects PostgreSQL installed
# on your system. Run `bun run db:create` to create the database named here.
# Format: postgresql://<user>[@<host>:<port>]/<database>
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/finfam

# ── Local Postgres overrides (optional — defaults shown) ───────────────
# Used by scripts/ensure-db.ts when creating the local database.
# FINFAM_DB_PASSWORD is optional; prefer DATABASE_URL for the app itself.
# FINFAM_DB_NAME=finfam
# FINFAM_DB_USER=postgres
# FINFAM_DB_PASSWORD=
# FINFAM_DB_PORT=5432

# ── Flow test suite override (optional) ────────────────────────────────
# `bun run test` drives the REAL dev server over HTTP. Override only when
# testing against a different running instance (defaults to port 3000).
# FLOW_TEST_BASE_URL=http://127.0.0.1:3000

# ── Transactional notifications (Mailjet) ─────────────────────────────
# Master switch. While false (the safe development default), lifecycle
# events still queue NotificationDelivery rows, but NO network request is
# ever attempted and suppressed sends are logged — fixtures/E2E can never
# email a real candidate. Turn true ONLY in a deployment with real
# credentials and a validated Mailjet sender address.
NOTIFICATIONS_ENABLED=false

# Mailjet transactional Send API (https://api.mailjet.com/v3.1/send),
# authenticated server-side with HTTP Basic. These are SERVER-ONLY secrets:
# never commit real values, never expose them to the browser bundle.
# MAILJET_FROM_EMAIL must be a validated/authorized sender in the Mailjet
# account before NOTIFICATIONS_ENABLED=true does anything useful.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME="FinFam Recruitment"

# Server-authoritative base URL used to build safe portal links in emails
# (e.g. /application/FF-XXXXXX). Never derived from client input.
APP_BASE_URL=http://127.0.0.1:3000

# Production requires HTTPS unless this is an isolated HTTP test deployment.
# Set true only for that local/test case; set false for normal deployments.
ALLOW_INSECURE_APP_BASE_URL=false

# Optional overrides (defaults shown).
# MAILJET_API_URL=https://api.mailjet.com/v3.1/send
# NOTIFICATIONS_MAX_ATTEMPTS=3
# NOTIFICATIONS_SEND_TIMEOUT_MS=10000

# ── Staff Portal (Stage 7) ─────────────────────────────────────────────
# DEVELOPMENT/TEST ONLY. When "true", POST /api/staff/auth/request-code
# returns the generated OTP in the response (devCode) so local development
# and the automated test suite can complete logins while
# NOTIFICATIONS_ENABLED=false (no real email is sent).
#  ┌─────────────────────────────────────────────────────────────────┐
#  │  PRODUCTION REQUIREMENT: STAFF_AUTH_DEV_CODE_ECHO MUST BE       │
#  │  "false" (or unset). An echoed OTP would let anyone sign in as  │
#  │  any Staff member with only their email address.                │
#  └─────────────────────────────────────────────────────────────────┘
STAFF_AUTH_DEV_CODE_ECHO=false

# Official Staff onboarding WhatsApp number (Stage 7 onboarding step 2).
# Leave EMPTY until the business supplies it: the onboarding communication
# step then shows honest pending copy (no fabricated number or link). When
# supplied (digits only, international format without "+", e.g.
# "2348012345678"), the step renders a real wa.me link with the pre-filled
# first message. No WhatsApp API integration is used or needed.
ONBOARDING_WHATSAPP_NUMBER=

# Official Staff WhatsApp Group invite link fallback (can be changed anytime by Admin in /admin/settings)
OFFICIAL_WHATSAPP_GROUP_LINK=

# ── Cloudinary Configuration (Credentials & document uploads) ─────────
# When configured, credentials (CV, passport photo, ID) uploaded in the
# application form are hosted on Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Staff Portal session duration in days (MVP default 7; configurable).
# STAFF_SESSION_TTL_DAYS=7

# ── Daily Reporting (Stage 8) ──────────────────────────────────────────
# How many past Africa/Lagos calendar days a staff member may backdate a
# daily report to (today included = 0). Approved MVP default: 7. Future
# dates are always rejected and there is deliberately no clock deadline.
# DAILY_REPORT_BACKDATE_LIMIT_DAYS=7

# ── Admin Console (Stage 11) ────────────────────────────────────────────
# Absolute admin session duration in HOURS (default 12). The admin surface
# carries privileged writes, so its TTL is deliberately much shorter than
# the Staff Portal's 7 days. No sliding renewal exists.
ADMIN_SESSION_TTL_HOURS=12

# ── Public-route rate limits (production-readiness remediation §14) ─────
# Conservative sliding-window limits for the UNAUTHENTICATED mutation /
# recovery endpoints (DB-backed, same pattern as the OTP request-window
# limiter). Values below are the code defaults — override only with a
# documented reason. Per client network (IP is hashed at rest, never
# stored raw). Set higher in the sandbox/test .env so the automated suite
# (which drives ~45 applications from one loopback address) is unaffected;
# the dedicated rate-limit regression test reads whatever config is active.
# APPLICATION_RATE_LIMIT_MAX=5
# APPLICATION_RATE_LIMIT_WINDOW_MS=600000
# RECOVERY_RATE_LIMIT_MAX=5
# RECOVERY_RATE_LIMIT_WINDOW_MS=600000
# ONBOARDING_REFERENCE_RATE_LIMIT_MAX=30
# ONBOARDING_REFERENCE_RATE_LIMIT_WINDOW_MS=600000
#
# EXTERNAL ACTION REQUIRED (deployment runbook): for a real production
# deployment, ALSO enforce IP throttling / request-flood protection at the
# reverse proxy or edge — the application limiter is abuse damping, not a
# DDoS defence.

# DEVELOPMENT/TEST ONLY. When "true", POST /api/admin/auth/request-code
# returns the generated admin OTP in the response (devCode) so local
# development and the automated test suite can complete admin sign-ins
# while NOTIFICATIONS_ENABLED=false (no real email is sent). This switch
# is deliberately SEPARATE from STAFF_AUTH_DEV_CODE_ECHO.
#  ┌─────────────────────────────────────────────────────────────────┐
#  │  PRODUCTION REQUIREMENT: ADMIN_AUTH_DEV_CODE_ECHO MUST BE       │
#  │  "false" (or unset). An echoed OTP would let anyone sign in as  │
#  │  any administrator with only their email address.               │
#  └─────────────────────────────────────────────────────────────────┘
ADMIN_AUTH_DEV_CODE_ECHO=false

# ── Phased production release schedule ────────────────────────────────
# ISO date-times with the WAT offset (+01:00). These gates affect production
# only; local development remains fully available. Leave unset to use the
# scheduled defaults below.
# APPLICANT_RELEASE_AT=2026-09-22T09:00:00+01:00
# ADMIN_RELEASE_AT=2026-09-28T09:00:00+01:00
# STAFF_RELEASE_AT=2026-10-07T09:00:00+01:00

# Admin accounts are provisioned operationally — there is no public
# registration route. Run:
#   bun run bootstrap:admin -- <email> [--dry-run]
# The script creates an ACTIVE AdminAccount, is idempotent for ACTIVE
# accounts, and REFUSES to reactivate suspended admins (recovery is an
# explicit future break-glass policy, never a script side effect).
